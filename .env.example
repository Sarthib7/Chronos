# Copy to .env and fill in. .env is git-ignored.

# Optional. Without it Chronos falls back to extractive summaries.
OPENROUTER_API_KEY=

# Optional. Cheap default chosen from OpenRouter's live model list.
OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# Optional. Per-request HTTP timeout in seconds.
HTTP_TIMEOUT=15
