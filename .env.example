# Copy to .env and fill in. .env is git-ignored.

# Optional. Without it Chronos falls back to extractive summaries.
OPENROUTER_API_KEY=

# Optional. Cheap default chosen from OpenRouter's live model list.
OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# Optional. Per-request HTTP timeout in seconds.
HTTP_TIMEOUT=15

# --- Masumi (API mode only; the CLI needs none of these) ---
# From the Masumi Payment Service admin dashboard. ReadAndPay permission is enough.
PAYMENT_API_KEY=
PAYMENT_SERVICE_URL=https://payment.masumi.network/api/v1
NETWORK=Preprod
# Issued after on-chain registration; changes if you re-register.
AGENT_IDENTIFIER=
# Payment key of the selling wallet used for the registration.
SELLER_VKEY=
# Optional. Which advertised source to sell through, by position in the agent's
# supported_payment_sources. Derived from the registry when the agent advertises
# a single priced source; required once it advertises more than one, because the
# index decides what the buyer is charged.
PAYMENT_SOURCE_INDEX=
